<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    <radialGradient id="bgGrad" cx="50%" cy="50%" r="70%">
      <stop offset="0%" stop-color="#180c08" />
      <stop offset="60%" stop-color="#0c0605" />
      <stop offset="100%" stop-color="#050202" />
    </radialGradient>
    <linearGradient id="textGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ef4444" />
      <stop offset="50%" stop-color="#f97316" />
      <stop offset="100%" stop-color="#fbbf24" />
    </linearGradient>
    <linearGradient id="cardGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1c100d" stop-opacity="0.9" />
      <stop offset="100%" stop-color="#0e0705" stop-opacity="0.95" />
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="1200" height="630" fill="url(#bgGrad)" />
  
  <!-- Glowing Amber Orbs -->
  <circle cx="200" cy="120" r="280" fill="#f97316" opacity="0.18" filter="blur(70px)" />
  <circle cx="1000" cy="520" r="320" fill="#ef4444" opacity="0.15" filter="blur(90px)" />

  <!-- Outer Elegant Frame -->
  <rect x="36" y="36" width="1128" height="558" rx="28" fill="url(#cardGrad)" stroke="#f97316" stroke-opacity="0.4" stroke-width="2" />
  <rect x="52" y="52" width="1096" height="526" rx="20" fill="none" stroke="#fbbf24" stroke-opacity="0.15" stroke-width="1" />

  <!-- Top Badge -->
  <rect x="465" y="85" width="270" height="42" rx="21" fill="#f97316" fill-opacity="0.15" stroke="#f97316" stroke-opacity="0.5" stroke-width="1" />
  <text x="600" y="112" font-family="serif" font-size="14" font-weight="bold" fill="#fbbf24" letter-spacing="4" text-anchor="middle">GASTRONOMIE 3D IMMERSIVE</text>

  <!-- Main Title -->
  <text x="600" y="215" font-family="serif" font-size="62" font-weight="900" fill="url(#textGrad)" letter-spacing="6" text-anchor="middle">L'AURA SAHARA</text>

  <!-- Subtitle -->
  <text x="600" y="275" font-family="sans-serif" font-size="20" font-weight="300" fill="#fed7aa" letter-spacing="2" text-anchor="middle">Menu Rotatif 3D &bull; Spécialités Wagyu &bull; Cocktails Fumés</text>

  <!-- Divider Fire Line -->
  <g transform="translate(600, 325)">
    <line x1="-300" y1="0" x2="-20" y2="0" stroke="#f97316" stroke-opacity="0.5" stroke-width="2" />
    <circle cx="0" cy="0" r="6" fill="#fbbf24" />
    <line x1="20" y1="0" x2="300" y2="0" stroke="#f97316" stroke-opacity="0.5" stroke-width="2" />
  </g>

  <!-- 3 Showcase Dish Preview Boxes -->
  <g transform="translate(180, 370)">
    <!-- Box 1 -->
    <rect x="0" y="0" width="250" height="130" rx="16" fill="#140a08" stroke="#f97316" stroke-opacity="0.3" stroke-width="1.5" />
    <text x="125" y="45" font-family="serif" font-size="16" font-weight="bold" fill="#ffffff" text-anchor="middle">Entrecôte Wagyu</text>
    <text x="125" y="75" font-family="sans-serif" font-size="13" fill="#fbbf24" font-weight="bold" text-anchor="middle">8 500 DA</text>
    <text x="125" y="102" font-family="sans-serif" font-size="11" fill="#a3a3a3" text-anchor="middle">Truffe Noire & Binchotan</text>

    <!-- Box 2 -->
    <translate x="285" y="0">
      <rect x="0" y="0" width="250" height="130" rx="16" fill="#140a08" stroke="#f97316" stroke-opacity="0.3" stroke-width="1.5" />
      <text x="125" y="45" font-family="serif" font-size="16" font-weight="bold" fill="#ffffff" text-anchor="middle">Loup de Mer Miso</text>
      <text x="125" y="75" font-family="sans-serif" font-size="13" fill="#fbbf24" font-weight="bold" text-anchor="middle">7 200 DA</text>
      <text x="125" y="102" font-family="sans-serif" font-size="11" fill="#a3a3a3" text-anchor="middle">Miso de Kyoto & Bok Choy</text>
    </translate>

    <!-- Box 3 -->
    <translate x="570" y="0">
      <rect x="0" y="0" width="250" height="130" rx="16" fill="#140a08" stroke="#f97316" stroke-opacity="0.3" stroke-width="1.5" />
      <text x="125" y="45" font-family="serif" font-size="16" font-weight="bold" fill="#ffffff" text-anchor="middle">Old Fashioned Fumé</text>
      <text x="125" y="75" font-family="sans-serif" font-size="13" fill="#fbbf24" font-weight="bold" text-anchor="middle">3 200 DA</text>
      <text x="125" y="102" font-family="sans-serif" font-size="11" fill="#a3a3a3" text-anchor="middle">Bourbon & Bois de Hickory</text>
    </translate>
  </g>

  <!-- Bottom Footer Info -->
  <text x="600" y="540" font-family="sans-serif" font-size="13" fill="#d1d5db" letter-spacing="1" text-anchor="middle">Ligne de Commande : 0659242630 &bull; Ouvert 7j/7 jusqu'à 23h00</text>
</svg>