<svg width="1200" height="630" viewBox="0 0 1200 630" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <!-- Background Gradients -->
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0a0504" />
      <stop offset="35%" stop-color="#140c0a" />
      <stop offset="70%" stop-color="#1a0e0b" />
      <stop offset="100%" stop-color="#070302" />
    </linearGradient>

    <linearGradient id="fireGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#ef4444" />
      <stop offset="45%" stop-color="#f97316" />
      <stop offset="100%" stop-color="#fbbf24" />
    </linearGradient>

    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#f59e0b" />
      <stop offset="100%" stop-color="#fef08a" />
    </linearGradient>

    <linearGradient id="cardGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="rgba(30,16,13,0.95)" />
      <stop offset="100%" stop-color="rgba(10,5,4,0.98)" />
    </linearGradient>

    <linearGradient id="callGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#16a34a" />
      <stop offset="50%" stop-color="#10b981" />
      <stop offset="100%" stop-color="#14b8a6" />
    </linearGradient>

    <!-- Filters for Glows -->
    <filter id="glowOrange" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="35" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>

    <filter id="glowSubtle" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="15" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>

    <!-- Card Clip Path -->
    <clipPath id="cardClip">
      <rect width="260" height="360" rx="28" />
    </clipPath>
  </defs>

  <!-- Background Base -->
  <rect width="1200" height="630" fill="url(#bgGrad)" />

  <!-- Ambient Glow Orbs -->
  <circle cx="200" cy="180" r="220" fill="#ea580c" opacity="0.22" filter="url(#glowOrange)" />
  <circle cx="1000" cy="320" r="280" fill="#ef4444" opacity="0.18" filter="url(#glowOrange)" />
  <circle cx="650" cy="550" r="200" fill="#f59e0b" opacity="0.15" filter="url(#glowOrange)" />

  <!-- Geometric Grid Accent Lines -->
  <g stroke="rgba(249,115,22,0.12)" stroke-width="1">
    <line x1="80" y1="0" x2="80" y2="630" />
    <line x1="1120" y1="0" x2="1120" y2="630" />
    <line x1="0" y1="80" x2="1200" y2="80" />
    <line x1="0" y1="550" x2="1200" y2="550" />
  </g>

  <!-- LEFT COLUMN: Brand Identity, Title, & Highlights -->
  <!-- Top Tag / Category -->
  <g transform="translate(100, 115)">
    <!-- Pill Badge -->
    <rect width="260" height="38" rx="19" fill="rgba(249,115,22,0.15)" stroke="rgba(249,115,22,0.5)" stroke-width="1.5" />
    <circle cx="22" cy="19" r="6" fill="#f97316" filter="url(#glowSubtle)" />
    <text x="38" y="24" font-family="Georgia, serif" font-size="13" font-weight="bold" fill="#fed7aa" letter-spacing="3">
      MENU 3D INTERACTIF
    </text>
  </g>

  <!-- Restaurant Name -->
  <text x="100" y="225" font-family="Georgia, serif" font-size="64" font-weight="900" fill="url(#fireGrad)" letter-spacing="4">
    L'AURA SAHARA
  </text>

  <!-- Subtitle -->
  <text x="100" y="275" font-family="system-ui, -apple-system, sans-serif" font-size="20" font-weight="300" fill="#fecdd3" letter-spacing="2">
    GASTRONOMIE &bull; PIZZAS &bull; BURGERS &bull; TACOS &bull; COCKTAILS
  </text>

  <!-- Description paragraph -->
  <text x="100" y="325" font-family="system-ui, -apple-system, sans-serif" font-size="16" fill="#9ca3af" font-weight="400">
    Explorez nos créations d'exception à travers un menu cylindre 3D inédit.
  </text>
  <text x="100" y="352" font-family="system-ui, -apple-system, sans-serif" font-size="16" fill="#9ca3af" font-weight="400">
    Commandes express, saveurs raffinées et service voiturier.
  </text>

  <!-- Key Highlights Bar -->
  <g transform="translate(100, 395)">
    <!-- Feature 1: Rating -->
    <rect width="145" height="52" rx="14" fill="rgba(255,255,255,0.05)" stroke="rgba(249,115,22,0.3)" />
    <text x="16" y="25" font-family="system-ui, sans-serif" font-size="18" font-weight="bold" fill="#fbbf24">&#9733; 4.9 / 5</text>
    <text x="16" y="42" font-family="system-ui, sans-serif" font-size="11" fill="#9ca3af">Avis Gourmets</text>

    <!-- Feature 2: Service Time -->
    <g transform="translate(160, 0)">
      <rect width="145" height="52" rx="14" fill="rgba(255,255,255,0.05)" stroke="rgba(249,115,22,0.3)" />
      <text x="16" y="25" font-family="system-ui, sans-serif" font-size="18" font-weight="bold" fill="#38bdf8">17h &ndash; 23h</text>
      <text x="16" y="42" font-family="system-ui, sans-serif" font-size="11" fill="#9ca3af">Ouvert 7j / 7</text>
    </g>

    <!-- Feature 3: Phone Order Badge -->
    <g transform="translate(320, 0)">
      <rect width="180" height="52" rx="14" fill="rgba(34,197,94,0.15)" stroke="rgba(34,197,94,0.6)" stroke-width="1.5" />
      <text x="16" y="25" font-family="system-ui, sans-serif" font-size="15" font-weight="bold" fill="#4ade80">&#128222; 0659 24 26 30</text>
      <text x="16" y="42" font-family="system-ui, sans-serif" font-size="11" fill="#86efac">Ligne de Commande</text>
    </g>
  </g>

  <!-- CTA Button Visual -->
  <g transform="translate(100, 475)">
    <rect width="250" height="50" rx="25" fill="url(#fireGrad)" filter="url(#glowSubtle)" />
    <text x="125" y="32" font-family="Georgia, serif" font-size="14" font-weight="bold" fill="#ffffff" text-anchor="middle" letter-spacing="3">
      DÉCOUVRIR LE MENU
    </text>
  </g>

  <!-- RIGHT COLUMN: 3D Cylinder Visual Representation -->
  <!-- Back / Side Left Card -->
  <g transform="translate(680, 155) rotate(-10)" opacity="0.6">
    <rect width="190" height="270" rx="22" fill="url(#cardGrad)" stroke="rgba(249,115,22,0.3)" stroke-width="1.5" />
    <rect x="15" y="15" width="160" height="130" rx="14" fill="#26120d" />
    <text x="25" y="180" font-family="Georgia, serif" font-size="15" font-weight="bold" fill="#fed7aa">Smash Wagyu</text>
    <text x="25" y="205" font-family="Georgia, serif" font-size="16" font-weight="bold" fill="#f97316">950 DA</text>
  </g>

  <!-- Back / Side Right Card -->
  <g transform="translate(940, 185) rotate(12)" opacity="0.75">
    <rect width="190" height="270" rx="22" fill="url(#cardGrad)" stroke="rgba(249,115,22,0.3)" stroke-width="1.5" />
    <rect x="15" y="15" width="160" height="130" rx="14" fill="#26120d" />
    <text x="25" y="180" font-family="Georgia, serif" font-size="15" font-weight="bold" fill="#fed7aa">Maxi Tacos</text>
    <text x="25" y="205" font-family="Georgia, serif" font-size="16" font-weight="bold" fill="#f97316">750 DA</text>
  </g>

  <!-- Main Hero Front Card -->
  <g transform="translate(790, 110)">
    <!-- Card Shadow/Glow -->
    <rect width="250" height="370" rx="28" fill="#f97316" opacity="0.2" filter="url(#glowOrange)" />
    <!-- Outer Card Frame -->
    <rect width="250" height="370" rx="28" fill="#140a08" stroke="url(#fireGrad)" stroke-width="2.5" />

    <!-- Top Badge -->
    <g transform="translate(18, 18)">
      <rect width="115" height="26" rx="13" fill="url(#fireGrad)" />
      <text x="57" y="17" font-family="Georgia, serif" font-size="11" font-weight="bold" fill="#ffffff" text-anchor="middle" letter-spacing="1">
        &#9733; SIGNATURE
      </text>
    </g>

    <!-- Star Rating in Card -->
    <g transform="translate(168, 18)">
      <rect width="64" height="26" rx="13" fill="rgba(0,0,0,0.6)" stroke="rgba(249,115,22,0.4)" />
      <text x="32" y="17" font-family="system-ui, sans-serif" font-size="11" font-weight="bold" fill="#fbbf24" text-anchor="middle">&#9733; 4.9</text>
    </g>

    <!-- Dish Image Placeholder / Illustration Graphic -->
    <rect x="18" y="56" width="214" height="175" rx="18" fill="#2a140f" />
    <!-- Decorative dish elements -->
    <circle cx="125" cy="143" r="60" fill="#ea580c" opacity="0.4" filter="url(#glowSubtle)" />
    <circle cx="125" cy="143" r="50" fill="#3f1c13" stroke="#f97316" stroke-dasharray="6,4" stroke-width="2" />
    <circle cx="125" cy="143" r="32" fill="#ef4444" opacity="0.8" />
    <text x="125" y="150" font-family="system-ui, sans-serif" font-size="28" text-anchor="middle">&#127829;</text>

    <!-- Dish Details -->
    <text x="20" y="260" font-family="Georgia, serif" font-size="18" font-weight="bold" fill="#ffffff">
      Pizza Pepperoni Suprême
    </text>
    <text x="20" y="280" font-family="system-ui, sans-serif" font-size="12" fill="#9ca3af">
      Cuite au feu de bois &bull; Mozzarella fior di latte
    </text>

    <!-- Price and Action -->
    <line x1="20" y1="300" x2="230" y2="300" stroke="rgba(249,115,22,0.25)" stroke-width="1" />
    <text x="20" y="335" font-family="Georgia, serif" font-size="24" font-weight="900" fill="url(#fireGrad)">
      700 DA
    </text>

    <g transform="translate(142, 312)">
      <rect width="88" height="34" rx="17" fill="url(#callGrad)" />
      <text x="44" y="22" font-family="system-ui, sans-serif" font-size="11" font-weight="bold" fill="#ffffff" text-anchor="middle">
        COMMANDER
      </text>
    </g>
  </g>

  <!-- Bottom Copyright / Domain Watermark -->
  <text x="600" y="595" font-family="Georgia, serif" font-size="13" fill="rgba(255,255,255,0.4)" text-anchor="middle" letter-spacing="3">
    L'AURA SAHARA &bull; EXPÉRIENCE GASTRONOMIQUE 3D IMMERSIVE
  </text>
</svg>